# Public URL of the app (behind your reverse proxy)
PUBLIC_URL=https://goshuin.example.com
# Use long random values, e.g.: openssl rand -base64 48
SECRET_KEY=
DB_PASSWORD=

# First admin user (created on startup if it doesn't exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# IPs or networks of the proxy whose X-Forwarded-* headers are trusted.
# With the port published by Docker, connections come from the Docker network gateway.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Optional
# BIND_ADDRESS=127.0.0.1
# PORT=8000
# MAX_UPLOAD_MB=25
# KEEP_ORIGINAL_EXIF=true
# GOSHUINCHO_VERSION=latest
# GOSHUINCHO_OWNER=goshuincho
# POSTGIS_IMAGE=postgis/postgis:16-3.4
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
