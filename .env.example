# URL pública con la que se accede a la app (detrás de tu proxy inverso)
PUBLIC_URL=https://goshuin.example.com
# Genera valores largos y aleatorios, por ejemplo: openssl rand -base64 48
SECRET_KEY=
DB_PASSWORD=

# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# IPs o redes del proxy cuyas cabeceras X-Forwarded-* se aceptan.
# Con el puerto publicado en Docker, la conexión llega desde la puerta de enlace de la red de Docker.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Opcionales
# BIND_ADDRESS=127.0.0.1
# PORT=8000
# MAX_UPLOAD_MB=25
# KEEP_ORIGINAL_EXIF=true
# GOSHUINCHO_VERSION=latest
# GOSHUINCHO_OWNER=goshuincho
# POSTGIS_IMAGE=postgis/postgis:16-3.4
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
